<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    AppCore Deploy Agent
    Runs on the live server (skyhost) as a Windows service.
    Receives a release package from the Deployment Center,
    backs up the database, installs the release and switches
    the live site to it (with automatic rollback).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AppCore.DeployAgent</RootNamespace>
    <AssemblyName>AppCore.DeployAgent</AssemblyName>
    <Version>1.0.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="install-agent.cmd" CopyToPublishDirectory="PreserveNewest" />
    <None Update="README.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
