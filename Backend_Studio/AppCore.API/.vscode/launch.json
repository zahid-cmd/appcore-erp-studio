{
    "version": "0.2.0",

    "configurations": [
        {
            "name": "AppCore API",
            "type": "coreclr",
            "request": "launch",

            "program": "${workspaceFolder}/bin/Debug/net10.0/AppCore.API.dll",

            "cwd": "${workspaceFolder}",

            "stopAtEntry": false,

            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },

            "console": "integratedTerminal",

            "launchBrowser": false
        }
    ]
}