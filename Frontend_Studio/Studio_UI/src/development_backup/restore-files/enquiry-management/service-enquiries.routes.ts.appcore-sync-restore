    {
        path:'list',

        data:
        {
            breadcrumb:'Service Enquiries'
        },

        loadComponent:() =>
            import(
                '../pages/service-enquiries/list/service-enquiries-list'
            )
            .then(
                m =>
                    m.ServiceEnquiriesList
            )
    },


    //===========================================================
