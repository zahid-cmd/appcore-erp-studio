        loadComponent:() =>
            import(
                '../pages/service-enquiries/form/service-enquiries-form'
            )
            .then(
                m =>
                    m.ServiceEnquiriesForm
            )
    },


    //===========================================================
    // Edit
    //===========================================================

    {
        path:'edit/:id',

        data:
        {
            breadcrumb:'Edit Service Enquiries'
        },

        loadComponent:() =>
            import(
                '../pages/service-enquiries/form/service-enquiries-form'
            )
            .then(
                m =>
                    m.ServiceEnquiriesForm
            )
    },


    //===========================================================
